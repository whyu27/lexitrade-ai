# Database configuration (LibSQL/SQLite/Turso)
# Local SQLite: file:lexitrade.db
# Turso Cloud: libsql://your-database-name.turso.io
DATABASE_URL=file:lexitrade.db
DATABASE_AUTH_TOKEN=

# AI Provider Configuration (Options: "mock", "gemini", "openai")
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Freshness and Risk thresholds
MARKET_DATA_FRESHNESS_SEC=300
DEFAULT_VIRTUAL_BALANCE=100000
